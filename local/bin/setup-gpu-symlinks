#!/usr/bin/env bash
# Creates stable /dev/dri symlinks so AQ_DRM_DEVICES keeps pointing at the right
# cards across reboots. The link names here are load-bearing: home/.zprofile and
# config/hypr/config/env_vars.lua name intel-igpu and nvidia-gpu, and Hyprland picks
# the NVIDIA card as primary if intel-igpu is missing -- which kills the external
# monitors on resume. See SUSPEND-FUSE.md (Incident 2). Rename nothing here without
# updating both of those files.
#
# Supersedes create_gpu_udev, which wrote two rule files, detected GPUs by grepping
# lspci output for vendor names, and never reloaded udev (so it needed a reboot).
set -euo pipefail

RULE_PATH="/etc/udev/rules.d/90-gpu-dev-path.rules"

detect_pci() {
  local vendor_hex="$1" # e.g. 0x8086 or 0x10de
  # Find a drm card whose parent device has the vendor we want
  for c in /sys/class/drm/card*; do
    [[ -e "$c/device/vendor" ]] || continue
    if [[ "$(cat "$c/device/vendor")" == "$vendor_hex" ]]; then
      # Resolve to PCI address like 0000:01:00.0
      readlink -f "$c/device" | awk -F/ '{print $NF}'
      return 0
    fi
  done
  return 1
}

INTEL_PCI=$(detect_pci 0x8086 || true)
NVIDIA_PCI=$(detect_pci 0x10de || true)

echo "Detected:"
echo "  Intel  PCI: ${INTEL_PCI:-<none>}"
echo "  NVIDIA PCI: ${NVIDIA_PCI:-<none>}"

UDEV_RULES='# Stable symlinks for Intel/NVIDIA DRM nodes (card + render)
# Generated automatically'

if [[ -n "${INTEL_PCI:-}" ]]; then
  UDEV_RULES+=$'\n'"# Intel iGPU"
  UDEV_RULES+=$'\n'"KERNEL==\"card*\",    SUBSYSTEM==\"drm\", SUBSYSTEMS==\"pci\", KERNELS==\"${INTEL_PCI}\",  SYMLINK+=\"dri/intel-igpu\""
  UDEV_RULES+=$'\n'"KERNEL==\"renderD*\", SUBSYSTEM==\"drm\", SUBSYSTEMS==\"pci\", KERNELS==\"${INTEL_PCI}\",  SYMLINK+=\"dri/intel-igpu-render\""
fi

if [[ -n "${NVIDIA_PCI:-}" ]]; then
  UDEV_RULES+=$'\n'"# NVIDIA dGPU"
  UDEV_RULES+=$'\n'"KERNEL==\"card*\",    SUBSYSTEM==\"drm\", SUBSYSTEMS==\"pci\", KERNELS==\"${NVIDIA_PCI}\", SYMLINK+=\"dri/nvidia-gpu\""
  UDEV_RULES+=$'\n'"KERNEL==\"renderD*\", SUBSYSTEM==\"drm\", SUBSYSTEMS==\"pci\", KERNELS==\"${NVIDIA_PCI}\", SYMLINK+=\"dri/nvidia-gpu-render\""
fi

echo "Writing rules to $RULE_PATH (sudo required)…"
echo "$UDEV_RULES" | sudo tee "$RULE_PATH" >/dev/null

echo "Reloading udev and triggering…"
sudo udevadm control --reload
sudo udevadm trigger -s drm

echo "Symlinks now (if devices are present):"
ls -l /dev/dri/ | sed 's/^/  /'
