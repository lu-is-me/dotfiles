# Neovim
alias v="nvim"
alias vim="nvim"
alias vk="NVIM_APPNAME=kickstart.nvim nvim"
alias chad="NVIM_APPNAME=nvchad.nvim nvim"
alias astro="NVIM_APPNAME=astro.nvim nvim"


# Better ls with eza
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons=auto'
  alias ll='eza --icons=auto -la'
  alias la='eza --icons=auto -a'
  alias l='eza --icons=auto'
else
  alias ll='ls -alF'
  alias la='ls -A'
  alias l='ls'
fi

# Navigation
alias ..='cd ..'

# Git
alias gs="git status"
alias gp="git pull"
alias gc="git commit"
alias lg="lazygit"

# Colorize and improve defaults
alias grep='grep --color=auto'
alias df="df -h"
alias free="free -m"

# Python venvs
alias venv="source .venv/bin/activate"


# Safety nets
alias cp="cp -i"
alias mv="mv -I"

# Fedora-specific
if [ -f "/etc/fedora-release" ]; then
  alias prime-run="__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia"
fi

